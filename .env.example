# Copy to .env and adjust.

# "local" enables the passwordless dev login. Use "production" when deployed:
# it requires a strong SECRET_KEY and refuses DEV_LOGIN_ENABLED.
ENVIRONMENT=local

# 32+ random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=terminator

# Google Sign-In (OAuth "Web application" client id). The button appears only
# when this ends in .apps.googleusercontent.com. Add your site's origin (e.g.
# http://localhost:5173) to "Authorized JavaScript origins". No client secret
# is needed: the frontend gets an ID token and the API verifies it.
GOOGLE_CLIENT_ID=

# Spotify controls while logging (needs Spotify Premium). Create an app at
# https://developer.spotify.com/dashboard, add redirect URIs for every origin
# you open the app on, e.g. http://127.0.0.1:5173/spotify/callback (Spotify
# doesn't accept "localhost") and https://your.domain/spotify/callback, and
# put its Client ID here. No client secret is needed.
SPOTIFY_CLIENT_ID=

# Admins (comma-separated): always allowed, and they choose who else may use the
# app under You -> Access. Empty: anyone who can sign in.
# ADMIN_EMAILS=me@gmail.com

# Optional overrides
# DEV_LOGIN_ENABLED=false
# BACKEND_CORS_ORIGINS=["https://example.com"]
